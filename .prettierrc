{
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 80,
  "useTabs": true,
  "bracketSpacing": true,
  "plugins": [
    "prettier-plugin-tailwindcss"
  ],
  "tailwindStylesheet": "src/app/globals.css",
  "tailwindFunctions": [
    "cn",
    "cva"
  ]
}
